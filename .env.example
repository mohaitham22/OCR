# Copy to .env and fill in. .env is gitignored; never commit real values.

# --- Extraction backend ---
DEFAULT_ENGINE=traditional          # traditional | vlm

# --- Model access ---
LLM_PROVIDER=gemini                 # gemini | openai | deepseek (deepseek: text only, no vision)
GEMINI_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
# Empty uses the selected provider's own default. Comment kept on its own
# line: python-dotenv does not strip a trailing "# ..." when there is nothing
# but whitespace before it, only when a real value precedes it -- an inline
# comment on an intentionally-empty field becomes the field's literal value.
LLM_MODEL=
VISION_MODEL=
LLM_MAX_TOKENS=8192
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=3

# --- OCR ---
OCR_BACKEND=paddle                  # paddle | tesseract
OCR_LANGUAGES=ar,en                 # comma separated, backend's own codes
OCR_MIN_CONFIDENCE=0.5
# Path to tesseract.exe if not on PATH. See the LLM_MODEL comment above for
# why this empty-by-default field has its comment on its own line.
TESSERACT_CMD=

# --- Preprocessing ---
PDF_DPI=300
MAX_IMAGE_PX=2500
DESKEW=true
AUTO_CROP=true
FIX_LIGHTING=true

# --- Validation and review gate ---
AMOUNT_TOLERANCE=0.02
REVIEW_CONFIDENCE_THRESHOLD=0.80

# --- Persistence (optional: leave empty to run without Postgres) ---
DATABASE_URL=
DB_POOL_MIN=1
DB_POOL_MAX=5

# --- Runtime ---
LOG_LEVEL=INFO
MAX_UPLOAD_MB=20
DATA_DIR=data
